# Prefer this file (gitignored as .env) — Cursor mcp.json loads it via envFile.
# Also supported: shell exports, Cursor MCP env UI, ~/.cursor-telegram/bot-token

# Bot API (telegram-bot MCP) — Cursor stdio + HTTP
TELEGRAM_BOT_TOKEN=
# Optional named bots: TELEGRAM_BOT_ALERTS=..., TELEGRAM_BOT_SALES=...

# User account MTProto (telegram-user MCP) — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: reuse a saved StringSession instead of interactive login
# TELEGRAM_SESSION=

# Optional: override session/credentials directory (default ~/.cursor-telegram)
# TELEGRAM_USER_DATA_DIR=

# Optional agent default: bot | user
# TELEGRAM_DEFAULT_IDENTITY=bot

# --- Grok Bot / self-host HTTP (node dist/cli.js http | docker compose) ---
# Does not affect Cursor stdio. See docs/grok-bot.md
# MCP_MODE=bot
# MCP_AUTH_TOKEN=
# PORT=8787
# HOST=0.0.0.0
# MCP_STATEFUL=false

# Bridge (optional) — see bridge/README.md
# BRIDGE_CHAT_ALLOWLIST=123456789
# BRIDGE_AUTO_REPLY=false
# CURSOR_API_KEY=
