{
  "name": "cursor-telegram-mcp",
  "version": "0.1.0",
  "description": "MCP servers for Telegram Bot API and personal user account (MTProto)",
  "type": "module",
  "bin": {
    "cursor-telegram-mcp": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "smoke": "node scripts/smoke-list-tools.mjs",
    "test": "npm run build && node --test test/**/*.test.mjs scripts/smoke-list-tools.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/example/cursor_tg_plugin.git"
  },
  "keywords": [
    "mcp",
    "telegram",
    "cursor",
    "bot",
    "mtproto"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "teleproto": "^1.232.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
